; Native PICA200 projection, model transform, and inspection lighting.
; Normals are generated from decoded triangles, not the game's material lighting.
.fvec projection[4], modelView[4], lighting
.constf constants(0.0, 1.0, 0.0, 0.0)
.constf light(0.3, 0.5, -0.8124038, 0.0)
.constf tint(1.0, 1.0, 1.0, 1.0)
.alias zeros constants.xxxx
.alias ones constants.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias position v0
.alias normal v1
.alias texcoord v2
.alias vertexcolor v3

.proc main
    mov r0.xyz, position
    mov r0.w, ones
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1

    mov r0.xyz, normal
    mov r0.w, zeros
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    mov r1.w, zeros
    dp3 r2, r1, r1
    rsq r2, r2
    mul r1, r1, r2
    dp3 r2.x, light, r1
    max r2.x, r2.x, -r2.x
    min r2.x, ones, r2.x
    mov r3, lighting
    mad r2.x, r2.x, lighting.y, r3.x
    mul outclr.xyz, vertexcolor, r2.xxxx
    mov outclr.w, ones
    mov outtc0, texcoord
    end
.end
