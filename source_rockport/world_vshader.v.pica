; World colour is already baked. Preserve the original two-stage position
; transform exactly, with no normal transform, normalization or lighting.
.fvec projection[4], modelView[4]
.constf constants(0.0, 1.0, 0.0, 0.0)
.alias ones constants.yyyy
.out outpos position
.out outclr color
.out outtc0 texcoord0
.alias position v0
.alias texcoord v1
.alias vertexcolor v2
.proc main
    mov r0.xyz, position
    mov r0.w, ones
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0
    dp4 outpos.x, projection[0], r1
    dp4 outpos.y, projection[1], r1
    dp4 outpos.z, projection[2], r1
    dp4 outpos.w, projection[3], r1
    mov outclr, vertexcolor
    mov outtc0, texcoord
    end
.end
